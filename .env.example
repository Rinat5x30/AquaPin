# Copy to .env (never commit .env). All secrets live in the environment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_ALLOWED_HOSTS=aquapin.example.org
DJANGO_HTTPS=1
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000

# Production database (job queue needs row locking: use Postgres). Leave empty for local SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram bot (optional). The webhook is disabled (503) until the secret is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Where live fields keep their frames and basemaps
AQUAPIN_DATA_DIR=./live_data
